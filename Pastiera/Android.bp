// Install the prebuilt apk.

package {
    default_applicable_licenses: ["packages_apps_Pastiera_license"],
}

license {
    name: "packages_apps_Pastiera_license",
    visibility: [":__subpackages__"],
    // GPLv3
}

android_app_import {
    name: "Pastiera",
    product_specific: true,
    default_dev_cert: true,
    arch: {
        arm64: {
            apk: "Pastiera.apk",
        },
    },
}
